rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Privatne bilješke: samo vlasnik
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Javni linkovi: čitanje samo ako znaš ID (nema listanja), pisanje samo prijavljeni
    match /shared/{sid} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
      match /c/{i} {
        allow get: if true;
        allow list: if false;
        allow write: if request.auth != null;
      }
    }
  }
}
